# Build state. Everything here is regenerated by the build and by the tests.
build/
*.o
*.ELF
*.elf
*.map
__pycache__/
*.pyc

# The toolchain and the 2.5 GB asset clone are external, never in Git.
tools/ps2shim/__pycache__/
assets/*.lz4f

# Measured from the external asset clone; reproducible with
# tools/measure_assets.py --assets <clone>, so the 2 MB JSON is committed but
# nothing larger.

# Gerado pelo fallback do compilar_windows.sh quando o pendrive nao aceita
# escrita; nunca vai para o Git.
FNFPS2-atualizacao.zip

# Bilhete que o script do Ubuntu escreve para o COMPILAR.bat ler: onde o
# jogo foi parar. Gerado a cada execucao, nunca vai para o Git.
.fnf_destino
FNFPS2-atualizacao.zip
FNF_COLHEITA.txt

# Telemetria do harness/console: saida de execucao, nunca fonte.
FNF_COLHEITA.txt

# Rascunho de mensagem de commit (nunca vai para o repo).
.commitmsg

# Artefatos de build (o ELF e o mapa saem por build.sh para build/dist)
/FNF_PS2.ELF
/FNF_PS2.map
/PROVA_PS2.ELF
/src/prova/*.o
/src/prova/*.ELF
/src/prova/*.map
/build/
/build.log
/build-tests.log
/assets/*.lz4f

# Armazenamento externo (Google Drive). O que ja' esta' rastreado permanece
# (gitignore so' afecta ficheiros novos); artefactos NOVOS grandes nunca
# entram: zips de entrega, toolchains e packs de arte.
google_drive/*.zip
google_drive/*.tar.xz
google_drive/*.lz4f
FNF_PS2_*.zip
